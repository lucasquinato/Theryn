{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"module": "ESNext",

		"rootDir": "./src",
		"outDir": "./dist",

		"strict": true,
		"noImplicitAny": true,
		"strictNullChecks": true,

		"sourceMap": true,
		"skipLibCheck": true,

		"paths": {
			// Engine
			"e@engine/*": ["./src/engine/*"],
			"e@camera/*": ["./src/engine/camera/*"],
			"e@canvas/*": ["./src/engine/canvas/*"],
			"e@config/*": ["./src/engine/config/*"],
			"e@controller/*": ["./src/engine/controller/*"],
			"e@ecs/*": ["./src/engine/ecs/*"],
			"e@input/*": ["./src/engine/input/*"],
			"e@loader/*": ["./src/engine/loader/*"],
			"e@render/*": ["./src/engine/render/*"],
			"e@types/*": ["./src/engine/types/*"],

			// Game
			"g@game/*": ["./src/game/*"],
			"g@assets/*": ["./src/game/assets/*"],
			"g@components/*": ["./src/game/components/*"],
			"g@config/*": ["./src/game/config/*"],
			"g@interaction/*": ["./src/game/interaction/*"],
			"g@maps/*": ["./src/game/maps/*"],
			"g@scenes/*": ["./src/game/scenes/*"],
			"g@render/*": ["./src/game/render/*"],
			"g@systems/*": ["./src/game/systems/*"],
			"g@tiles/*": ["./src/game/tiles/*"]
		}
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist"]
}
